# ==============================================================================
# Badminton E-Commerce Platform - Environment Variables Template
# Copy this file to .env and fill in your actual values: cp .env.example .env
# ==============================================================================

# Docker & Container Configuration
DOCKER_USERNAME=your_dockerhub_username
IMAGE_TAG=latest
NODE_ENV=production

# Server Port
PORT=4000

# Database Configuration (MongoDB Atlas)
MONGO_DB=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/badminton?retryWrites=true&w=majority

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Security & Authentication Secrets
ACCESS_TOKEN=your_strong_jwt_access_secret_here
REFRESH_TOKEN=your_strong_jwt_refresh_secret_here

# Nodemailer / Email Service
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Grafana Monitoring Dashboard
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# EC2 Public IP or Domain (Used for Grafana Root URL routing)
EC2_PUBLIC_IP=localhost
